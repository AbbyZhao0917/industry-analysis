# 环境变量配置
# 复制此文件为 .env 并填入实际值

# Anthropic API Key（如使用中转站，填中转站提供的 key）
ANTHROPIC_API_KEY=your-key-here

# API 地址（直接连 Anthropic 则不需要此行；使用中转站则填中转站地址）
ANTHROPIC_BASE_URL=https://api.ofox.ai/anthropic

# 模型名称
ANTHROPIC_MODEL=anthropic/claude-sonnet-4.6

# Tavily 搜索 API Key（免费 1000 次/月，注册地址：https://tavily.com）
TAVILY_API_KEY=your-tavily-key-here
# Firecrawl 网页抓取 API Key（免费 500 credits/月，注册：https://firecrawl.dev）
FIRECRAWL_API_KEY=your-firecrawl-key-here
